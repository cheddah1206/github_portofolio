<mxCell id="c74" value="&lt;b&gt;Operations team (Slack channel)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;receives incident dispatch, rejections, escalations, systemic alerts&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F3F2;strokeColor=#0E7C7B;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1220" y="575" width="260" height="52" as="geometry"/></mxCell>
<mxCell id="c75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1155" y="504" as="sourcePoint"/><mxPoint x="1220" y="601" as="targetPoint"/><Array as="points"><mxPoint x="1188" y="504"/><mxPoint x="1188" y="601"/></Array></mxGeometry></mxCell>
<mxCell id="c76" value="Incident outcomes (incidents.state)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1215" y="101" width="400" height="19" as="geometry"/></mxCell>
<mxCell id="c77" value="COMPLETED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#17324D;fontColor=#17324D;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="124" width="92" height="22" as="geometry"/></mxCell>
<mxCell id="c78" value="final — dispatched / self-healed" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1320" y="130" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c79" value="REJECTED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#17324D;fontColor=#17324D;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="164" width="92" height="22" as="geometry"/></mxCell>
<mxCell id="c80" value="final — invalid or human-rejected" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1320" y="170" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c81" value="ESCALATED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#3E6A97;fontColor=#17324D;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="204" width="92" height="22" as="geometry"/></mxCell>
<mxCell id="c82" value="recoverable — retries / stale / timeout" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1320" y="210" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c83" value="FAILED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FBECEA;strokeColor=#B42318;fontColor=#B42318;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="244" width="92" height="22" as="geometry"/></mxCell>
<mxCell id="c84" value="recoverable — workflow error" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1320" y="250" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c85" value="" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1220" y="283" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c87" value="&lt;b&gt;Supabase — PostgreSQL (via native Supabase node)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;incidents · audit_logs · approvals · system_config&lt;br&gt;evidenced from node operations; no SQL schema supplied (see View 3)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=12;strokeWidth=1.5;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="320" y="675" width="570" height="105" as="geometry"/></mxCell>
<mxCell id="c88" value="&lt;b&gt;Postgres — AI chat memory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;session key ct-hs-&amp;lt;contactId&amp;gt; or ct-ent-&amp;lt;dept&amp;gt;-&amp;lt;entity&amp;gt;&lt;br&gt;table name = node default (inferred)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="930" y="675" width="260" height="105" as="geometry"/></mxCell>
<mxCell id="c89" value="Not shown as edges for readability:" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1215" y="695" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c90" value="CT-01 AI Agent ↔ Postgres chat memory" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1215" y="711" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c91" value="All inter-workflow state writes go via CT-02" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1215" y="726" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c92" value="Table-level R/W by workflow → View 3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1215" y="741" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c93" value="&lt;b&gt;Reliability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;Retries: HubSpot lookup ×3 · Slack dispatch ×3 · AI agent ×2. Dispatch failure → RETRYING → CT-05 loop (linear back-off, max 3) → ESCALATED. AI failure → safe default + mandatory approval. Stale-state scan: 10 min (60 min awaiting approval).&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="840" width="465" height="110" as="geometry"/></mxCell>
<mxCell id="c94" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;No authentication configured on POST /ops-events or POST /ops-recover (webhook options empty). Credentials referenced only (Supabase, Slack, Gmail, Gemini, HubSpot, Postgres); no secrets exposed here. Approver address and Slack channel IDs are hard-coded in workflow nodes.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="525" y="840" width="465" height="110" as="geometry"/></mxCell>
<mxCell id="c95" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;One audit_logs row per state change (written by CT-02). CT-04 Error Workflow: Slack alert + audit/FAILED — but configured on CT-06 only (not CT-01 / CT-05). Systemic alert: 3+ HIGH/CRITICAL incidents in one department within 15 min.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="840" width="495" height="110" as="geometry"/></mxCell>
<mxCell id="c96" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&amp;#9632; n8n workflow / internal component&lt;br&gt;&amp;#9632; External system / SaaS&lt;br&gt;&amp;#9632; Human actor&lt;br&gt;&amp;#9632; Disabled / orphaned component&lt;br&gt;&amp;#9632; Incident outcome state&lt;br&gt;&amp;#8594; Confirmed call / data flow&lt;br&gt;&amp;#8674; Disabled (inactive) path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1530" y="80" width="300" height="141" as="geometry"/></mxCell>
<mxCell id="c97" value="Red tags mark audit findings (see report)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1530" y="235" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c98" value="Derived from JSON only; nothing was executed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1530" y="251" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c99" value="Grouped arrows are labelled with their callers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1530" y="267" width="400" height="18" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page2" name="VIEW 2A — Detailed Workflow &amp; Decision Flow: Intake, AI Assessment, Scoring and Approval (CT-01 with CT-02)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="VIEW 2A — Detailed Workflow &amp; Decision Flow: Intake, AI Assessment, Scoring and Approval (CT-01 with CT-02)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="subtitle" value="v1.0  |  Source: CT-01 Main, CT-02 State &amp; Audit Writer  |  CURRENT STATE (as exported)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1100" height="18" as="geometry"/></mxCell>
<mxCell id="c2" value="LANE 1 · INTAKE &amp; VALIDATION  (CT-01; EVERY STATE CHANGE IS WRITTEN THROUGH CT-02)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1800" height="225" as="geometry"/></mxCell>
<mxCell id="c3" value="LANE 2 · CRM CONTEXT &amp; AI ASSESSMENT  (READ RIGHT → LEFT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="1800" height="285" as="geometry"/></mxCell>
<mxCell id="c4" value="LANE 3 · SCORING OUTCOME, HUMAN APPROVAL &amp; HAND-OFF TO DISPATCH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1800" height="360" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;font color=&quot;#B42318&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[NO AUTH]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Webhook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;POST /ops-events · responseMode: Respond node&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Validate &amp;amp; normalise&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;event_id · ISO timestamp · department · event_type · severity · entity_id · payload object&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="235" y="145" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;SHA-256 payload hash&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;stored as payload_hash (not used to de-duplicate)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="145" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;font color=&quot;#0E7C7B&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[DB READ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Check duplicate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;SELECT incidents WHERE event_id = ?&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625" y="145" width="160" height="80" as="geometry"/></mxCell>
