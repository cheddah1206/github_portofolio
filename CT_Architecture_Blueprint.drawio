<mxCell id="c85" value="proposed link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#0E7C7B;strokeWidth=1.5;dashed=1;fontSize=9;fontColor=#0E7C7B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="1124" as="sourcePoint"/><mxPoint x="280" y="1122" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c86" value="&lt;font color=&quot;#0E7C7B&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[EXT]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Slack: error alert&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="1060" width="200" height="38" as="geometry"/></mxCell>
<mxCell id="c87" value="&lt;font color=&quot;#0E7C7B&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[DB READ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Find incident by execution_id&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="1108" width="200" height="38" as="geometry"/></mxCell>
<mxCell id="c88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="1090" as="sourcePoint"/><mxPoint x="500" y="1079" as="targetPoint"/><Array as="points"><mxPoint x="475" y="1090"/><mxPoint x="475" y="1079"/></Array></mxGeometry></mxCell>
<mxCell id="c89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="1090" as="sourcePoint"/><mxPoint x="500" y="1127" as="targetPoint"/><Array as="points"><mxPoint x="475" y="1127"/></Array></mxGeometry></mxCell>
<mxCell id="c90" value="Open incident?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="750" y="1082" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="c91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1127" as="sourcePoint"/><mxPoint x="750" y="1127" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c92" value="&lt;font color=&quot;#0E7C7B&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[CT-02]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CT-02: → FAILED (WORKFLOW_ERROR)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="1060" width="240" height="44" as="geometry"/></mxCell>
<mxCell id="c93" value="&lt;font color=&quot;#0E7C7B&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[DB WRITE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;audit_logs row only (no state change)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="1116" width="240" height="44" as="geometry"/></mxCell>
<mxCell id="c94" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="1127" as="sourcePoint"/><mxPoint x="980" y="1082" as="targetPoint"/><Array as="points"><mxPoint x="945" y="1127"/><mxPoint x="945" y="1082"/></Array></mxGeometry></mxCell>
<mxCell id="c95" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="1127" as="sourcePoint"/><mxPoint x="980" y="1138" as="targetPoint"/><Array as="points"><mxPoint x="945" y="1138"/></Array></mxGeometry></mxCell>
<mxCell id="c96" value="Note: the lookup uses the failed execution id." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1250" y="1070" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c97" value="That matches incidents created by CT-01 executions only;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1250" y="1086" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c98" value="failures in CT-05 / CT-06 fall through to audit-only." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1250" y="1102" width="400" height="17" as="geometry"/></mxCell>
<mxCell id="c99" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&amp;#9632; n8n step / workflow node&lt;br&gt;&amp;#9632; External system&lt;br&gt;&amp;#8674; Gap: control not configured&lt;br&gt;&amp;#9632; Hand-off / state&lt;br&gt;&amp;#8594; Confirmed flow&lt;br&gt;&amp;#8674; Proposed link (target state)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1500" y="880" width="300" height="124" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page4" name="VIEW 3 — Database &amp; Data Relationship Diagram (ERD-style)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="VIEW 3 — Database &amp; Data Relationship Diagram (ERD-style)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="subtitle" value="v1.0  |  Source: Supabase / Postgres node parameters in CT-01…CT-07  |  EVIDENCED structures (solid) vs RECOMMENDED additions (dashed teal) — no SQL DDL was supplied" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1100" height="18" as="geometry"/></mxCell>
<mxCell id="c2" value="A · EVIDENCED STRUCTURES (NAMES INFERRED FROM NODE MAPPINGS; TYPES AND CONSTRAINTS NOT ESTABLISHED)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1170" height="880" as="geometry"/></mxCell>
<mxCell id="c3" value="B · RECOMMENDED STRUCTURES (PROPOSED, NOT PRESENT IN THE EXPORTS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#0E7C7B;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#0E7C7B;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="610" height="880" as="geometry"/></mxCell>
<mxCell id="c9" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="200" as="sourcePoint"/><mxPoint x="520" y="200" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c10" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="470" as="sourcePoint"/><mxPoint x="520" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c11" value="&lt;b&gt;Integrity gaps evidenced in the workflows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;• No unique constraint on incidents.event_id is evidenced: CT-01 de-duplicates with SELECT-then-INSERT (race window).&lt;br&gt;• CT-02 updates incidents WHERE id only (no state guard) and writes audit_logs in a second call — no transaction.&lt;br&gt;• Foreign keys shown are inferred from shared ids; no DDL supplied.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="270" height="290" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Idempotency &amp;amp; duplicate-write risks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;• CT-07 (when enabled) would write a note per final-state transition; no check of an earlier HUBSPOT_NOTE_CREATED row.&lt;br&gt;• CT-03 posts to Slack with retry ×3 and is re-invoked by CT-05: a lost response can duplicate alerts.&lt;br&gt;• CT-05 runs can overlap: two runs may pick the same RETRYING incident (no claim/lock).&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="790" height="120" as="geometry"/></mxCell>
<mxCell id="c13" value="Cardinalities are logical (inferred from use of incident_id); enforcement in the database is not evidenced." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c14" value="Chat memory has no relational link to incidents; the session key encodes HubSpot contact id or department + entity id." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#475569;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="846" width="400" height="18" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Why only these additions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Candidate tables from the brief (business_events, assessment_results, incident_records, retry_records, integration_logs) are NOT recommended: incidents already holds the event, the AI assessment and retry counters, and audit_logs already records every transition. New tables are limited to gaps the workflows actually exhibit.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0FAF9;strokeColor=#0E7C7B;dashed=1;fontColor=#0E7C7B;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1250" y="640" width="560" height="150" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&amp;#9632; Evidenced entity (solid)&lt;br&gt;&amp;#8674; Proposed entity / column (dashed teal, italic)&lt;br&gt;&amp;#8674; Integrity gap&lt;br&gt;&amp;#8594; Logical relationship (inferred, not DDL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1250" y="810" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;incidents&lt;/b&gt;&lt;br&gt;id &lt;font color=&quot;#475569&quot;&gt;[PK (inferred)]&lt;/font&gt;&lt;br&gt;incident_no &lt;font color=&quot;#475569&quot;&gt;[human key]&lt;/font&gt;&lt;br&gt;event_id &lt;font color=&quot;#475569&quot;&gt;[idempotency key]&lt;/font&gt;&lt;br&gt;event_timestamp&lt;br&gt;department&lt;br&gt;event_type&lt;br&gt;severity&lt;br&gt;entity_id&lt;br&gt;payload &lt;font color=&quot;#475569&quot;&gt;[object]&lt;/font&gt;&lt;br&gt;payload_hash&lt;br&gt;execution_id&lt;br&gt;state &lt;font color=&quot;#475569&quot;&gt;[state machine]&lt;/font&gt;&lt;br&gt;created_at / updated_at / resolved_at&lt;br&gt;retry_count / max_retries&lt;br&gt;next_retry_at / last_error&lt;br&gt;rejection_reason&lt;br&gt;ai_category / ai_impact_score / ai_confidence&lt;br&gt;ai_summary / ai_recommended_action / ai_failed&lt;br&gt;risk_score / priority / sla_due&lt;br&gt;requires_approval / notify_departments&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Read: CT-01 (dup check), CT-04, CT-05 (3 queries), CT-06, CT-07 · Insert: CT-01 · Update: CT-01 (classification), CT-02 (state + patch). Owner of state transitions: CT-02.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#17324D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="390" height="381" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;audit_logs&lt;/b&gt;&lt;br&gt;id &lt;font color=&quot;#475569&quot;&gt;[PK (inferred)]&lt;/font&gt;&lt;br&gt;incident_id &lt;font color=&quot;#475569&quot;&gt;[FK → incidents.id (inferred)]&lt;/font&gt;&lt;br&gt;event_id &lt;font color=&quot;#475569&quot;&gt;[copy of incidents.event_id]&lt;/font&gt;&lt;br&gt;execution_id&lt;br&gt;workflow_name&lt;br&gt;event &lt;font color=&quot;#475569&quot;&gt;[e.g. CLASSIFIED]&lt;/font&gt;&lt;br&gt;previous_state / new_state&lt;br&gt;status &lt;font color=&quot;#475569&quot;&gt;[SUCCESS|WARNING|FAILURE|INFO]&lt;/font&gt;&lt;br&gt;error_message&lt;br&gt;actor&lt;br&gt;payload_hash&lt;br&gt;metadata &lt;font color=&quot;#475569&quot;&gt;[object]&lt;/font&gt;&lt;br&gt;created_at &lt;font color=&quot;#475569&quot;&gt;[assumed default]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Insert only: CT-02 (every state change), CT-04 (error-only), CT-05 (systemic alert), CT-07 (HubSpot sync). incident_id omitted by CT-04/CT-05 rows ⇒ column must be nullable (inferred).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#17324D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="330" height="287" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;approvals&lt;/b&gt;&lt;br&gt;id &lt;font color=&quot;#475569&quot;&gt;[PK (inferred)]&lt;/font&gt;&lt;br&gt;incident_id &lt;font color=&quot;#475569&quot;&gt;[FK → incidents.id (inferred)]&lt;/font&gt;&lt;br&gt;status &lt;font color=&quot;#475569&quot;&gt;[PENDING|APPROVED|REJECTED|TIMEOUT]&lt;/font&gt;&lt;br&gt;approver_email &lt;font color=&quot;#475569&quot;&gt;[hard-coded placeholder]&lt;/font&gt;&lt;br&gt;reason&lt;br&gt;execution_id&lt;br&gt;decided_at&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Insert + update: CT-01 only. No decided_by / token evidence.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#17324D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="430" width="330" height="164" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;system_config&lt;/b&gt;&lt;br&gt;key &lt;font color=&quot;#475569&quot;&gt;[PK? (inferred)]&lt;/font&gt;&lt;br&gt;value&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Read: CT-03 (dispatch_channel_id, simulate_slack_failure). Write path not present in any workflow.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#17324D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="270" height="111" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;n8n chat memory table (Postgres)&lt;/b&gt;&lt;br&gt;session_id &lt;font color=&quot;#475569&quot;&gt;[ct-hs-&amp;lt;contactId&amp;gt; | ct-ent-&amp;lt;dept&amp;gt;-&amp;lt;entity&amp;gt;]&lt;/font&gt;&lt;br&gt;message &lt;font color=&quot;#475569&quot;&gt;[chat turns (node-managed)]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Name/schema = Postgres Chat Memory node default (inferred). Read/write: CT-01 AI Agent only. Separate credential from Supabase.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#17324D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="270" height="111" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;incidents (+ proposed)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;version  int &lt;font color=&quot;#475569&quot;&gt;[optimistic concurrency]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;claimed_by / claimed_at &lt;font color=&quot;#475569&quot;&gt;[retry lease for CT-05]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;UNIQUE (event_id) &lt;font color=&quot;#475569&quot;&gt;[DB-level idempotency]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;INDEX (state, next_retry_at) &lt;font color=&quot;#475569&quot;&gt;[watchdog scans]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;INDEX (execution_id) &lt;font color=&quot;#475569&quot;&gt;[CT-04 lookup]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Closes: duplicate ingest race, double dispatch, slow stale scans.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#F0FAF9;strokeColor=#0E7C7B;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="270" height="145" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;approvals (+ proposed)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;decided_by &lt;font color=&quot;#475569&quot;&gt;[verified approver identity]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;decision_source &lt;font color=&quot;#475569&quot;&gt;[email link | recovery]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;UNIQUE (incident_id) WHERE status = PENDING&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Closes: unverifiable approver, bypass via recovery.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#F0FAF9;strokeColor=#0E7C7B;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1540" y="120" width="270" height="115" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;crm_sync_log (proposed)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;id &lt;font color=&quot;#475569&quot;&gt;[PK uuid]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;incident_id &lt;font color=&quot;#475569&quot;&gt;[FK → incidents.id]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;final_state &lt;font color=&quot;#475569&quot;&gt;[COMPLETED|REJECTED|…]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;hubspot_contact_id&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;hubspot_note_id&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;status &lt;font color=&quot;#475569&quot;&gt;[SUCCESS|WARNING|FAILURE]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;created_at &lt;font color=&quot;#475569&quot;&gt;[timestamptz]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;UNIQUE (incident_id, final_state) &lt;font color=&quot;#475569&quot;&gt;[idempotent notes]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Only if CT-07 is enabled. Closes: duplicate HubSpot notes; makes CT-07 re-runnable.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#F0FAF9;strokeColor=#0E7C7B;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1250" y="330" width="270" height="190" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;dead_letter_events (proposed)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;id &lt;font color=&quot;#475569&quot;&gt;[PK uuid]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;received_at &lt;font color=&quot;#475569&quot;&gt;[timestamptz]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;raw_body &lt;font color=&quot;#475569&quot;&gt;[jsonb]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;failure_stage &lt;font color=&quot;#475569&quot;&gt;[ingest | db | ai]&lt;/font&gt;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;error_message&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#0E7C7B&quot;&gt;replayed_at&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Phase 4. Closes: events lost when CT-01 fails before an incident row exists.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#F0FAF9;strokeColor=#0E7C7B;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1540" y="330" width="270" height="160" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page5" name="VIEW 4 — API &amp; Integration Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="VIEW 4 — API &amp; Integration Architecture" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="subtitle" value="v1.0  |  Source: node types, operations and credential references in CT-01…CT-07  |  CURRENT STATE (as exported) — credential values are never shown; only credential types referenced" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1100" height="18" as="geometry"/></mxCell>
<mxCell id="c2" value="1 · INBOUND CALLERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="260" height="480" as="geometry"/></mxCell>
<mxCell id="c3" value="2 · N8N RUNTIME — CREDENTIAL TRUST BOUNDARY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="560" height="480" as="geometry"/></mxCell>
<mxCell id="c4" value="3 · EXTERNAL SERVICES &amp; APIS (AUTHENTICATION · BEHAVIOUR · RISK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="910" height="480" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;n8n scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Schedule Trigger → CT-05&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Business systems&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;event emitters (HTTP client)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="185" width="220" height="45" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Operations manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;recovery request&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F3F2;strokeColor=#0E7C7B;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Internal triggers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;Schedule (CT-05) · Error Trigger (CT-04) · Execute Workflow Trigger (CT-02, CT-03, CT-07)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="115" width="500" height="50" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;font color=&quot;#B42318&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[NO AUTH]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Inbound webhooks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;POST /ops-events → CT-01   ·   POST /ops-recover → CT-06. Webhook options are empty: no authentication is configured on either endpoint; recovery accepts a self-asserted actor.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="180" width="500" height="90" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Workflows CT-01 … CT-07&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;Native n8n nodes for Supabase, Slack, Gmail, HubSpot search, Gemini and Postgres memory; one generic HTTP Request node (CT-07, HubSpot notes). Inter-workflow calls use Execute Workflow nodes.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="290" width="500" height="90" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;n8n credential store (references only)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;supabaseApi · slackApi · gmailOAuth2 · googlePalmApi · hubspotAppToken · postgres. The same credential entries are reused by every workflow that needs a service (no per-workflow privilege separation evidenced). Secrets are not exposed in this document.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F3F2;strokeColor=#0E7C7B;fontColor=#17324D;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="400" width="500" height="140" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" target="c8"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="140" as="sourcePoint"/><mxPoint x="350" y="140" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c13" value="POST /ops-events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="207" as="sourcePoint"/><mxPoint x="350" y="207" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c14" value="POST /ops-recover" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="265" as="sourcePoint"/><mxPoint x="350" y="265" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c15" value="&lt;b&gt;Supabase (PostgreSQL REST, native node)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;incidents · audit_logs · approvals · system_config  — all 7 workflows&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="945" y="112" width="390" height="55" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;supabaseApi · key privilege not visible in export (verify least privilege) · most DB nodes have no retry or onError; several sequential calls per state change&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1345" y="112" width="470" height="55" as="geometry"/></mxCell>
<mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="139" as="sourcePoint"/><mxPoint x="945" y="139" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c18" value="&lt;b&gt;Slack (Web API, native node)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;CT-01 · CT-03 · CT-04 · CT-05 — post message to channel&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="945" y="175" width="390" height="55" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;slackApi · channel IDs hard-coded except CT-03 (system_config) · retry ×3 only in CT-03; CT-05 nodes have none&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1345" y="175" width="470" height="55" as="geometry"/></mxCell>
<mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="202" as="sourcePoint"/><mxPoint x="945" y="202" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c21" value="&lt;b&gt;Gmail (OAuth2, native node)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;CT-01 sendAndWait (45 min) · CT-05 send escalation email&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="945" y="238" width="390" height="55" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;gmailOAuth2 · recipient hard-coded and inconsistent across nodes · quota/limits not assessed&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1345" y="238" width="470" height="55" as="geometry"/></mxCell>
<mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="265" as="sourcePoint"/><mxPoint x="945" y="265" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c24" value="&lt;b&gt;Google Gemini (LangChain chat model)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;CT-01 AI Agent — model name not pinned in export, temperature 0.2&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="945" y="301" width="390" height="55" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;googlePalmApi · retry ×2 then deterministic fallback · output schema conflicts with prompt&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1345" y="301" width="470" height="55" as="geometry"/></mxCell>
<mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="328" as="sourcePoint"/><mxPoint x="945" y="328" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c27" value="&lt;b&gt;Postgres (direct connection)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;CT-01 Postgres Chat Memory — session history per customer / entity&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="945" y="364" width="390" height="55" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;postgres credential (separate from Supabase) · retention of customer-linked history undefined&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1345" y="364" width="470" height="55" as="geometry"/></mxCell>
<mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;endFill=1;startFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="391" as="sourcePoint"/><mxPoint x="945" y="391" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c30" value="&lt;b&gt;HubSpot — native node (App Token)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;CT-01 · CT-07 — search contacts: email EQ, oldest first&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#475569;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="945" y="427" width="390" height="55" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#475569&quot;&gt;hubspotAppToken · retry ×3 · continue on error · customer email sent as search value&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;fontColor=#17324D;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1345" y="427" width="470" height="55" as="geometry"/></mxCell>
